# Generates a C++ translation unit that embeds UI assets byte-for-byte.
# Assets are encoded as hex so arbitrary content is safe. No external tools
# are required beyond CMake itself.
function(gbx_embed_assets out_cpp)
  set(content "// Generated by cmake/EmbedAssets.cmake. Do not edit.\n")
  string(APPEND content "#include \"ui/assets.hpp\"\n\nnamespace gbx::ui::assets {\n")
  set(entries "")
  foreach(path IN LISTS ARGN)
    get_filename_component(name "${path}" NAME)
    string(MAKE_C_IDENTIFIER "asset_${name}" ident)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "static const unsigned char ${ident}[] = {${bytes}0x00};\n")
    list(APPEND entries "  {\"${name}\", std::string_view(reinterpret_cast<const char*>(${ident}), sizeof(${ident}) - 1)},")
  endforeach()
  string(APPEND content "\nstatic const Asset kAssets[] = {\n")
  foreach(entry IN LISTS entries)
    string(APPEND content "${entry}\n")
  endforeach()
  string(APPEND content "};\n\n")
  string(APPEND content "std::span<const Asset> all() { return {kAssets, sizeof(kAssets) / sizeof(kAssets[0])}; }\n")
  string(APPEND content "const Asset* find(std::string_view name) {\n")
  string(APPEND content "  for (const auto& a : kAssets) {\n")
  string(APPEND content "    if (name == a.name) return &a;\n")
  string(APPEND content "  }\n  return nullptr;\n}\n")
  string(APPEND content "}  // namespace gbx::ui::assets\n")
  file(WRITE "${out_cpp}" "${content}")
endfunction()
